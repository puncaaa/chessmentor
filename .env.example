# Project Environment Configuration
PROJECT_NAME="Chess B2B SaaS"
ENVIRONMENT="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/chess_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# Chess Engine
STOCKFISH_PATH="/opt/homebrew/bin/stockfish"
STOCKFISH_DEPTH=16
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128

# External Sync APIs
LICHESS_API_TOKEN=""
CHESSCOM_USER_AGENT="ChessSaaSPlatform/1.0 (dev@chess-saas.com)"

# LLM Providers (OpenAI / Gemini)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
